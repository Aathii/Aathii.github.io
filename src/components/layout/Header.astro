---
import Icon from '../ui/Icon.astro';
import { socialIcon } from '../ui/icons';
import { mailto, nav, site } from '../../config/site';
---

<header id="site-header" class="site-header">
	<div class="container-page header-inner">
		<a href="#top" class="brand">
			<span class="mark" aria-hidden="true">
				<span class="mark-fill" data-drift="4 4"></span>
				<span class="mark-box">{site.initials}</span>
			</span>
			<span class="brand-name">{site.name}</span>
		</a>

		<nav class="nav-desktop" aria-label="Primary">
			{
				nav.map((item) => (
					<a href={item.href} data-nav-link class="nav-link label">
						{item.label}
					</a>
				))
			}
			{
				site.resumeUrl && (
					<a href={site.resumeUrl} target="_blank" rel="noopener" class="nav-link label">
						Résumé
					</a>
				)
			}
		</nav>

		<div class="header-actions">
			<a href={mailto()} class="hire label">
				<svg class="hire-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M4 5h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H9l-5 4V6a1 1 0 0 1 1-1z" />
				</svg>
				<span>Get in touch</span>
			</a>
			<button id="menu-toggle" type="button" class="menu-toggle label" aria-expanded="false" aria-controls="mobile-menu">
				<span class="menu-word" data-open>Menu</span>
				<span class="menu-word" data-close>Close</span>
			</button>
		</div>
	</div>
</header>

<div id="mobile-menu" class="mobile-menu" inert>
	<nav class="container-page mobile-nav" aria-label="Mobile">
		<ol>
			{
				nav.map((item, i) => (
					<li style={`--i:${i}`}>
						<a href={item.href} class="mobile-link">{item.label}<span class="dot">.</span></a>
					</li>
				))
			}
			{
				site.resumeUrl && (
					<li style={`--i:${nav.length}`}>
						<a href={site.resumeUrl} target="_blank" rel="noopener" class="mobile-link">Résumé<span class="dot">.</span></a>
					</li>
				)
			}
		</ol>
		<div class="mobile-foot" style={`--i:${nav.length + 1}`}>
			<a href={mailto()} class="ilink">{site.contact.email}</a>
			<ul class="flex gap-2">
				{
					site.socials.map((s) => (
						<li>
							<a href={s.url} target="_blank" rel="noopener noreferrer" class="social-round" aria-label={`${s.label} (opens in a new tab)`}>
								<Icon name={socialIcon(s.label)} size={20} />
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</nav>
</div>

<style>
	.site-header {
		position: fixed;
		top: var(--frame);
		left: var(--frame);
		right: var(--frame);
		z-index: 50;
		transition:
			background-color 0.35s ease,
			box-shadow 0.35s ease;
	}

	.site-header.is-scrolled {
		background: rgba(244, 246, 251, 0.9);
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
		box-shadow: 0 1px 0 var(--color-hair);
	}

	:global(body.menu-open) .site-header {
		background: transparent;
		box-shadow: none;
		backdrop-filter: none;
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		height: 4.5rem;
	}

	@media (min-width: 768px) {
		.header-inner {
			height: 5.25rem;
		}
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.9rem;
		color: var(--color-ink);
	}

	/* Monogram: an outlined tile with a flat periwinkle copy offset behind it. */
	.mark {
		position: relative;
		width: 2.6rem;
		height: 2.6rem;
		flex-shrink: 0;
	}

	.mark-fill,
	.mark-box {
		position: absolute;
		inset: 0;
		border-radius: 9px;
	}

	.mark-fill {
		background: var(--color-fill);
		translate: 4px 4px;
	}

	.mark-box {
		display: grid;
		place-items: center;
		border: 2px solid var(--color-line);
		background: var(--color-paper);
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.05rem;
		letter-spacing: -0.02em;
		color: var(--color-line);
		transition: transform 0.4s var(--ease-over);
	}

	@media (hover: hover) {
		.brand:hover .mark-box {
			transform: rotate(-6deg);
		}
	}

	/* Visually hidden on phones (the monogram carries the brand) but always the link's accessible name. */
	.brand-name {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.1rem;
		padding-left: 0.9rem;
		border-left: 1px solid var(--color-hair);
	}

	@media (min-width: 640px) {
		.brand-name {
			position: static;
			width: auto;
			height: auto;
			overflow: visible;
			clip-path: none;
		}
	}

	.nav-desktop {
		display: none;
		gap: 2.25rem;
	}

	@media (min-width: 1024px) {
		.nav-desktop {
			display: flex;
		}
	}

	/* Tracked caps; the tracking opens up on hover. */
	.nav-link {
		position: relative;
		padding-block: 0.6rem;
		transition:
			letter-spacing 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94),
			color 0.2s ease;
	}

	.nav-link::after {
		content: '';
		position: absolute;
		left: 0;
		bottom: 0.2rem;
		width: 100%;
		height: 2px;
		background: var(--color-accent);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.3s var(--ease-out);
	}

	@media (hover: hover) {
		.nav-link:hover {
			letter-spacing: 0.3em;
		}
	}

	.nav-link[aria-current='true']::after {
		transform: scaleX(1);
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	.hire {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		min-height: 2.75rem;
		color: var(--color-ink);
		transition: letter-spacing 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
	}

	.hire-icon {
		color: var(--color-line);
		transition: transform 0.35s var(--ease-over);
	}

	@media (hover: hover) {
		.hire:hover {
			letter-spacing: 0.3em;
		}
		.hire:hover .hire-icon {
			transform: rotate(-10deg) scale(1.1);
		}
	}

	/* Icon-only on small phones, but the words stay available to screen readers. */
	@media (max-width: 479px) {
		.hire span {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
			white-space: nowrap;
		}
	}

	/* MENU / CLOSE flip. */
	.menu-toggle {
		position: relative;
		display: grid;
		min-width: 3.75rem;
		min-height: 2.75rem;
		overflow: hidden;
		padding-left: 1.25rem;
		border-left: 1px solid var(--color-hair);
		text-align: left;
		cursor: pointer;
	}

	.menu-word {
		grid-area: 1 / 1;
		align-self: center;
		transition:
			transform 0.45s var(--ease-over),
			opacity 0.3s ease;
	}

	.menu-word[data-close] {
		transform: translate3d(0, 120%, 0);
		opacity: 0;
	}

	.menu-toggle[aria-expanded='true'] .menu-word[data-open] {
		transform: translate3d(0, -120%, 0);
		opacity: 0;
	}

	.menu-toggle[aria-expanded='true'] .menu-word[data-close] {
		transform: none;
		opacity: 1;
	}

	@media (min-width: 1024px) {
		.menu-toggle {
			display: none;
		}
	}

	/* ---------- Full-screen colour-wipe menu ---------- */
	.mobile-menu {
		position: fixed;
		inset: var(--frame);
		z-index: 45;
		display: flex;
		background: var(--color-fill);
		transform: translate3d(0, -101%, 0);
		visibility: hidden;
		transition:
			transform 0.7s cubic-bezier(0.165, 0.84, 0.44, 1),
			visibility 0s linear 0.7s;
	}

	.mobile-menu.is-open {
		transform: none;
		visibility: visible;
		transition:
			transform 0.7s cubic-bezier(0.165, 0.84, 0.44, 1),
			visibility 0s;
	}

	.mobile-nav {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding-top: 7rem;
		padding-bottom: 2rem;
	}

	.mobile-nav ol {
		display: grid;
		gap: 0.35rem;
	}

	.mobile-link {
		display: inline-block;
		padding-block: 0.3rem;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: clamp(2.6rem, 11vw, 4.25rem);
		line-height: 1.1;
		letter-spacing: -0.015em;
		color: var(--color-ink);
	}

	.mobile-menu li,
	.mobile-foot {
		opacity: 0;
		transform: translate3d(0, 14px, 0);
		transition:
			opacity 0.25s ease,
			transform 0.25s ease;
	}

	.mobile-menu.is-open li,
	.mobile-menu.is-open .mobile-foot {
		opacity: 1;
		transform: none;
		transition:
			opacity 0.6s var(--ease-out) calc(0.35s + var(--i) * 0.08s),
			transform 0.6s var(--ease-out) calc(0.35s + var(--i) * 0.08s);
	}

	.mobile-foot {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--color-hair);
	}

	.mobile-foot .ilink {
		background-image: linear-gradient(var(--color-paper), var(--color-paper));
	}

	.social-round {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 999px;
		border: 2px solid var(--color-ink);
		color: var(--color-ink);
	}

	@media (min-width: 1024px) {
		.mobile-menu {
			display: none;
		}
	}
</style>
