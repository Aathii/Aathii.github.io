---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Button from '../components/ui/Button.astro';
---

<Layout title="Page not found" noindex>
	<Header />
	<main id="main" class="container-page grid min-h-[80svh] content-center py-32" data-inert-when-menu>
		<p class="label text-muted">404</p>
		<h1 class="mt-6 text-[clamp(3rem,8vw,6rem)] leading-none">That page <b>doesn't exist</b><span class="dot">.</span></h1>
		<span class="rule" aria-hidden="true"></span>
		<p class="measure">The link may be old or mistyped. Everything lives on the home page.</p>
		<div class="mt-8">
			<Button href="/" icon="arrowRight">Back to the portfolio</Button>
		</div>
	</main>
</Layout>
