---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Button from '../components/ui/Button.astro';
---

<Layout title="Page not found" noindex>
	<Header />
	<main id="main" class="grid min-h-svh place-items-center px-6 py-32">
		<div class="grid max-w-xl justify-items-start gap-6">
			<p class="eyebrow"><b>404</b> / Not found</p>
			<h1 class="font-hero text-[clamp(3rem,10vw,7rem)] font-bold leading-[0.95] tracking-[-0.05em]">
				That page<br />doesn't exist.
			</h1>
			<p class="text-lg text-bone-dim">The link may be old, or mistyped. The work is all on the home page.</p>
			<Button href="/" size="lg" icon="arrowRight">Back to the portfolio</Button>
		</div>
	</main>
</Layout>
