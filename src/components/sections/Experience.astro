---
import { education, experience } from '../../data/content';
---

<section id="experience" class="section" aria-labelledby="experience-title" data-inert-when-menu>
	<div class="container-page">
		<div class="measure">
			<h2 id="experience-title" class="h-section" data-reveal>My <b>experience</b><span class="dot">.</span></h2>
			<span class="rule" data-reveal="rule" aria-hidden="true"></span>
		</div>

		<ol class="roles">
			{
				experience.map((role) => (
					<li class="role" data-reveal>
						<div class="role-head">
							{role.period && <p class="label edu-label">{role.period}</p>}
							<h3 class="role-title">{role.title}</h3>
							<p class="role-org">
								{role.orgUrl ? (
									<a href={role.orgUrl} target="_blank" rel="noopener noreferrer" class="ilink">
										{role.org}
									</a>
								) : (
									<span>{role.org}</span>
								)}
								{role.current && <span class="now">Current</span>}
							</p>
							{(role.note || role.location) && (
								<p class="role-meta">{[role.note, role.location].filter(Boolean).join(' · ')}</p>
							)}
						</div>
						<ul class="role-points">
							{role.points.map((point) => <li>{point}</li>)}
						</ul>
					</li>
				))
			}
			<li class="role" data-reveal>
				<div class="role-head">
					<p class="label edu-label">Education · {education.period}</p>
					<h3 class="role-title">{education.degree}</h3>
					<p class="role-org"><span>{education.school}</span></p>
				</div>
				<ul class="role-points">
					<li>{education.program}</li>
				</ul>
			</li>
		</ol>
	</div>
</section>

<style>
	.roles {
		border-top: 1px solid var(--color-hair);
	}

	.role {
		display: grid;
		gap: 1rem;
		padding-block: 2rem;
		border-bottom: 1px solid var(--color-hair);
	}

	@media (min-width: 900px) {
		.role {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
			gap: clamp(3rem, 6vw, 5.5rem);
			padding-block: 2.5rem;
		}
	}

	.edu-label {
		margin-bottom: 0.5rem;
		font-size: 0.68rem;
		color: var(--color-muted);
	}

	.role-title {
		font-size: clamp(1.5rem, 1vw + 1.15rem, 1.9rem);
		font-weight: 700;
		line-height: 1.15;
	}

	.role-org {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.75rem;
		margin-top: 0.4rem;
		font-size: 1.05rem;
		color: var(--color-ink);
	}

	.role-meta {
		margin-top: 0.35rem;
		font-size: 0.92rem;
		color: var(--color-muted);
	}

	/* Comfortable tap height for the organisation links. */
	.role-org .ilink {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		background-position: 0 78%;
	}

	.now {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.2rem 0.65rem;
		border-radius: 999px;
		border: 1.5px solid var(--color-line);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-line);
	}

	.now::before {
		content: '';
		width: 0.4rem;
		height: 0.4rem;
		border-radius: 999px;
		background: var(--color-line);
	}

	.role-points {
		display: grid;
		gap: 0.6rem;
		max-width: 38rem;
		align-content: start;
		padding-top: 0.2rem;
	}

	/* Dot bullets. */
	.role-points li {
		position: relative;
		padding-left: 1.4rem;
	}

	.role-points li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.72em;
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 999px;
		background: var(--color-fill);
		box-shadow: inset 0 0 0 1.5px var(--color-line);
	}
</style>
