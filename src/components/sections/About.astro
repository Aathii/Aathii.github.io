---
import { aboutParagraphs, facts } from '../../data/content';
import { site } from '../../config/site';
---

<section id="about" class="section" aria-labelledby="about-title" data-inert-when-menu>
	<div class="container-page about-grid">
		<div class="about-visual" data-reveal>
			{
				site.photo ? (
					<figure class="portrait">
						<img src={site.photo} alt={`Portrait of ${site.name}`} width="800" height="1000" loading="lazy" decoding="async" />
					</figure>
				) : (
					<div class="portrait portrait-mono" role="img" aria-label={`${site.name} monogram`}>
						<span aria-hidden="true">{site.initials}</span>
					</div>
				)
			}
		</div>

		<div class="about-copy">
			<p class="eyebrow" data-reveal><b>02</b> / About</p>
			<h2 id="about-title" class="section-title mt-8" data-reveal="clip">
				<span class="reveal-inner">Design and code, <em>one</em> pair of hands.</span>
			</h2>

			<div class="about-text">
				{aboutParagraphs.map((p) => <p data-reveal>{p}</p>)}
			</div>

			<dl class="facts">
				{
					facts.map((f) => (
						<div data-reveal>
							<dt>{f.label}</dt>
							<dd>{f.value}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</div>
</section>

<style>
	.about-grid {
		display: grid;
		gap: 3.5rem;
	}

	.portrait {
		position: relative;
		width: 100%;
		max-width: min(100%, 20rem);
		aspect-ratio: 4 / 5;
		overflow: hidden;
		border-radius: var(--radius-card);
		border: 1px solid var(--color-line);
		background: var(--color-panel);
	}

	.portrait img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.portrait-mono {
		display: grid;
		place-items: center;
		background:
			radial-gradient(70% 60% at 25% 12%, rgba(198, 244, 50, 0.16), transparent 62%),
			radial-gradient(80% 70% at 95% 100%, rgba(255, 255, 255, 0.06), transparent 62%),
			var(--color-panel);
	}

	.portrait-mono span {
		font-family: var(--font-hero);
		font-weight: 700;
		font-size: clamp(6rem, 22vw, 11rem);
		letter-spacing: -0.07em;
		line-height: 1;
	}

	.about-text {
		display: grid;
		gap: 1.5rem;
		max-width: 62ch;
		margin-top: 2.5rem;
		font-size: clamp(1.05rem, 1.6vw, 1.25rem);
		line-height: 1.65;
		color: var(--color-bone-dim);
	}

	.facts {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.75rem 1.5rem;
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid var(--color-line);
	}

	.facts dt {
		margin-bottom: 0.35rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.facts dd {
		font-size: 1rem;
		line-height: 1.4;
		color: var(--color-bone);
	}

	@media (min-width: 640px) {
		.portrait {
			max-width: 26rem;
		}
	}

	@media (min-width: 1024px) {
		.about-grid {
			grid-template-columns: repeat(12, minmax(0, 1fr));
			gap: 0 2rem;
			align-items: start;
		}

		.about-visual {
			grid-column: 1 / span 4;
			position: sticky;
			top: 7rem;
		}

		.about-copy {
			grid-column: 6 / span 7;
		}
	}
</style>
