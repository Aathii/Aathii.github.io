---
import LineIcon from '../ui/LineIcon.astro';
import { aboutParagraphs, pillars } from '../../data/content';
---

<section id="about" class="section" aria-labelledby="about-title" data-inert-when-menu>
	<div class="container-page about-grid">
		<div class="measure">
			<h2 id="about-title" class="h-section" data-reveal>I build things, <b>and I sell them</b><span class="dot">.</span></h2>
			<span class="rule" data-reveal="rule" aria-hidden="true"></span>
			<div class="copy">
				{aboutParagraphs.map((p, i) => <p data-reveal style={`--reveal-delay:${300 + i * 90}ms`}>{p}</p>)}
			</div>
		</div>

		<ul class="pillars">
			{
				pillars.map((p, i) => (
					<li class="pillar" data-reveal style={`--reveal-delay:${200 + i * 120}ms`}>
						<LineIcon name={p.icon} size={42} />
						<div>
							<h3 class="pillar-label">{p.label}<span class="dot">.</span></h3>
							<p>{p.text}</p>
						</div>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.about-grid {
		display: grid;
		gap: clamp(3.5rem, 7vw, 5rem);
	}

	@media (min-width: 1024px) {
		.about-grid {
			grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
			justify-content: space-between;
			gap: 5rem;
			align-items: end;
		}
	}

	.pillars {
		display: grid;
		border-top: 1px solid var(--color-hair);
	}

	.pillar {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 1.25rem;
		align-items: start;
		padding-block: 1.6rem;
		border-bottom: 1px solid var(--color-hair);
	}

	.pillar-label {
		font-size: 1.6rem;
		font-weight: 700;
		line-height: 1.1;
	}

	.pillar p {
		margin-top: 0.35rem;
		font-size: 1rem;
	}
</style>
