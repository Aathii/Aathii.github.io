---
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/geist/index.css';
import '../styles/global.css';
import displayFont from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import bodyFont from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import { site } from '../config/site';
import { experience, skills } from '../data/content';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
}

const {
	title = `${site.name} | ${site.headline}`,
	description = site.description,
	noindex = !site.live,
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://aathii.github.io');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = new URL(`${import.meta.env.BASE_URL}og-image.png`, siteUrl).href;

// Derived from content.ts so the structured data can't drift from what the page says.
const currentJob = experience[0];
const ogImageAlt = `${site.name}: ${site.headline}`;
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	'@id': `${siteUrl.href}#person`,
	name: site.name,
	givenName: site.firstName,
	familyName: site.name.replace(site.firstName, '').trim(),
	jobTitle: ['Software Developer', currentJob.title],
	worksFor: { '@type': 'Organization', name: currentJob.org },
	address: { '@type': 'PostalAddress', addressLocality: 'Toronto', addressRegion: 'ON', addressCountry: 'CA' },
	knowsLanguage: skills.find((g) => g.label === 'Spoken')?.items ?? [],
	knowsAbout: skills.filter((g) => ['Languages', 'Mobile & web', 'AI & computer vision'].includes(g.label)).flatMap((g) => g.items),
	description: site.description,
	url: siteUrl.href,
	image: new URL(`${import.meta.env.BASE_URL}portrait.webp`, siteUrl).href,
	email: `mailto:${site.contact.email}`,
	alumniOf: { '@type': 'CollegeOrUniversity', name: site.education, sameAs: 'https://www.utoronto.ca' },
	sameAs: site.socials.map((s) => s.url),
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<script is:inline>
			document.documentElement.classList.add('js');
			// If the main script never runs (blocked, errored) the hero must still appear.
			setTimeout(function () {
				document.documentElement.classList.add('is-ready');
			}, 2000);
		</script>
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
		{!noindex && <link rel="canonical" href={canonicalUrl} />}
		<meta name="theme-color" content="#ffffff" />
		<meta name="color-scheme" content="light" />

		<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} sizes="32x32" />
		<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
		<link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />

		<link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{!noindex && <meta property="og:url" content={canonicalUrl} />}
		<meta property="og:locale" content="en_CA" />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content={ogImageAlt} />
		<meta name="twitter:creator" content="@aathiiraku" />

		{!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
	</head>
	<body>
		<div id="top" class="absolute top-0 h-px w-px"></div>
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:left-6 focus:top-6 focus:z-[100] focus:rounded-lg focus:bg-line focus:px-5 focus:py-3 focus:text-sm focus:font-semibold focus:text-white"
		>
			Skip to content
		</a>

		<div class="sheet">
			<slot />
		</div>

		<div class="frame" aria-hidden="true"></div>
		<p id="copy-status" class="sr-only" role="status" aria-live="polite"></p>

		<script>
			import '../scripts/main';
		</script>
	</body>
</html>
