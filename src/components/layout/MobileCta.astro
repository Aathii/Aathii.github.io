---
import Button from '../ui/Button.astro';
import { mailto, site } from '../../config/site';
---

<!-- Phones only: shows after the hero, hides over the contact section (scripts/mobile-cta.ts). -->
<div id="mobile-cta" class="mobile-cta md:hidden" inert>
	<div class="flex items-center gap-2 rounded-full border border-line bg-ink/80 p-1.5 backdrop-blur-xl">
		<Button href={mailto()} size="sm" icon="mail" class="flex-1">Get in touch</Button>
		{
			site.resumeUrl && (
				<Button href={site.resumeUrl} size="sm" variant="ghost" icon="download" download>
					Résumé
				</Button>
			)
		}
	</div>
</div>

<style>
	.mobile-cta {
		position: fixed;
		inset: auto 0 0 0;
		z-index: 40;
		padding: 0.75rem max(1rem, env(safe-area-inset-right)) max(0.85rem, env(safe-area-inset-bottom))
			max(1rem, env(safe-area-inset-left));
		transform: translate3d(0, 130%, 0);
		opacity: 0;
		transition:
			transform 0.7s var(--ease-premium),
			opacity 0.4s ease;
	}

	.mobile-cta.is-visible {
		transform: none;
		opacity: 1;
	}
</style>
