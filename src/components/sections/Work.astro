---
import Icon from '../ui/Icon.astro';
import ProjectRow from './ProjectRow.astro';
import { moreWork, projects } from '../../data/content';
---

<section id="work" class="section" aria-labelledby="work-title" data-inert-when-menu>
	<div class="container-page">
		<div class="measure">
			<h2 id="work-title" class="h-section" data-reveal>Selected <b>work</b><span class="dot">.</span></h2>
			<span class="rule" data-reveal="rule" aria-hidden="true"></span>
			<p data-reveal style="--reveal-delay:300ms">
				A product I'm building, a tool I made for my own sales job, the company I co-founded, and websites for small
				businesses. Hover a screenshot to scroll through the real site.
			</p>
		</div>

		<div class="projects">
			{projects.map((project, i) => <ProjectRow project={project} index={i} />)}
		</div>

		<div class="more">
			<h3 class="label more-title" data-reveal>More</h3>
			<ul>
				{
					moreWork.map((item) => (
						<li data-reveal>
							<a href={item.url} target="_blank" rel="noopener noreferrer" class="more-row">
								<span class="more-name">{item.title}</span>
								<span class="more-note">{item.note}</span>
								<span class="more-go">
									{item.linkLabel}
									<Icon name="arrowUpRight" size={16} />
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<style>
	.projects {
		margin-top: clamp(3.5rem, 7vw, 5.5rem);
	}

	.more {
		margin-top: clamp(3.5rem, 7vw, 5rem);
	}

	.more-title {
		margin-bottom: 1rem;
		color: var(--color-muted);
	}

	.more-row {
		display: grid;
		gap: 0.25rem 2rem;
		padding-block: 1.25rem;
		border-bottom: 1px solid var(--color-hair);
	}

	@media (min-width: 768px) {
		.more-row {
			grid-template-columns: 17rem minmax(0, 1fr) auto;
			align-items: baseline;
		}
	}

	.more-name {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.35rem;
		color: var(--color-ink);
	}

	.more-note {
		font-size: 0.98rem;
	}

	.more-go {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-weight: 600;
		font-size: 0.95rem;
		color: var(--color-line);
		transition: gap 0.25s var(--ease-out);
	}

	@media (hover: hover) {
		.more-row:hover .more-go {
			gap: 0.65rem;
		}
		.more-row:hover .more-name {
			color: var(--color-line);
		}
	}
</style>
