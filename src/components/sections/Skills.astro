---
import { skills } from '../../data/content';
---

<section id="skills" class="section" aria-labelledby="skills-title" data-inert-when-menu>
	<div class="container-page">
		<div class="measure">
			<h2 id="skills-title" class="h-section" data-reveal>My <b>toolkit</b><span class="dot">.</span></h2>
			<span class="rule" data-reveal="rule" aria-hidden="true"></span>
		</div>

		<dl class="kit">
			{
				skills.map((group) => (
					<div class="kit-row" data-reveal>
						<dt class="label">{group.label}</dt>
						<dd>{group.items.join(' · ')}</dd>
					</div>
				))
			}
		</dl>
	</div>
</section>

<style>
	.kit {
		border-top: 1px solid var(--color-hair);
	}

	.kit-row {
		display: grid;
		gap: 0.4rem;
		padding-block: 1.35rem;
		border-bottom: 1px solid var(--color-hair);
	}

	@media (min-width: 900px) {
		.kit-row {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
			gap: clamp(3rem, 6vw, 5.5rem);
			align-items: baseline;
		}
	}

	.kit-row dt {
		color: var(--color-muted);
	}

	.kit-row dd {
		font-size: 1.05rem;
		color: var(--color-ink);
	}
</style>
