---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { socialIcon } from '../ui/icons';
import { mailto, site } from '../../config/site';
---

<section id="contact" class="section contact" aria-labelledby="contact-title" data-inert-when-menu>
	<span class="contact-dots dots" data-drift="10 10" aria-hidden="true"></span>
	<div class="container-page">
		<div class="measure">
			<h2 id="contact-title" class="contact-title" data-reveal>Let's <b>talk</b><span class="dot">.</span></h2>
			<span class="rule" data-reveal="rule" aria-hidden="true"></span>
			<p class="lede" data-reveal style="--reveal-delay:300ms">
				Hiring, collaborating, or just want to say hi? I read every message and reply personally.
			</p>

			<div class="mail" data-reveal style="--reveal-delay:400ms">
				<a href={mailto()} class="mail-link ilink">{site.contact.email}</a>
				<button type="button" class="copy-btn" data-copy={site.contact.email} aria-label="Copy email address">
					<Icon name="copy" size={16} />
					<span data-copy-label>Copy</span>
				</button>
			</div>

			<div class="contact-actions" data-reveal style="--reveal-delay:480ms">
				<Button href={mailto()} icon="mail">Email me</Button>
				{
					site.resumeUrl && (
						<Button href={site.resumeUrl} icon="arrowUpRight" target="_blank" rel="noopener">
							View résumé (PDF)
						</Button>
					)
				}
			</div>

			<ul class="contact-social" data-reveal style="--reveal-delay:560ms">
				{
					site.socials.map((s) => (
						<li>
							<a href={s.url} target="_blank" rel="noopener noreferrer" class="tlink">
								<Icon name={socialIcon(s.label)} size={17} />
								<span>{s.label}</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<style>
	.contact {
		position: relative;
		overflow: clip;
	}

	.contact-dots {
		position: absolute;
		right: 8%;
		top: 38%;
		width: 16rem;
		height: 14rem;
		display: none;
	}

	@media (min-width: 1024px) {
		.contact-dots {
			display: block;
		}
	}

	.contact-title {
		font-size: clamp(3rem, 6vw + 0.75rem, 6rem);
		line-height: 1;
		letter-spacing: -0.02em;
	}

	.mail {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.25rem;
		margin-top: 2.25rem;
	}

	.mail-link {
		display: inline-block;
		padding-block: 0.35rem;
		background-position: 0 85%;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: clamp(1.5rem, 2.4vw + 0.9rem, 2.4rem);
		line-height: 1.3;
		overflow-wrap: anywhere;
	}

	.copy-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		min-height: 2.75rem;
		padding-inline: 1rem;
		border-radius: 999px;
		border: 1.5px solid var(--color-hair);
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--color-ink-2);
		cursor: pointer;
		transition:
			border-color 0.2s ease,
			color 0.2s ease;
	}

	@media (hover: hover) {
		.copy-btn:hover {
			border-color: var(--color-line);
			color: var(--color-line);
		}
	}

	.copy-btn[data-state='copied'] {
		border-color: var(--color-line);
		color: var(--color-line);
	}

	.copy-btn[data-state='failed'] {
		border-color: var(--color-accent);
		color: #b33a12;
	}

	.contact-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	.contact-social {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.75rem;
		margin-top: 1.75rem;
	}
</style>
