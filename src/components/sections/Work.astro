---
import Icon from '../ui/Icon.astro';
import ProjectRow from './ProjectRow.astro';
import { moreWork, projects, systemsWork } from '../../data/content';
---

<section id="work" class="section" aria-labelledby="work-title" data-inert-when-menu>
	<div class="container-page">
		<div class="measure">
			<h2 id="work-title" class="h-section" data-reveal>Selected <b>work</b><span class="dot">.</span></h2>
			<span class="rule" data-reveal="rule" aria-hidden="true"></span>
			<p data-reveal style="--reveal-delay:300ms">
				An app I'm building, automation I made for my own sales job, the company I co-founded, websites for small
				businesses, and some systems work. Hover a screenshot to scroll through the real site.
			</p>
		</div>

		<div class="projects">
			{projects.map((project, i) => <ProjectRow project={project} index={i} />)}
		</div>

		<div class="systems">
			<h3 class="h-sub systems-title" data-reveal>Systems <b>&amp; languages</b><span class="dot">.</span></h3>
			<ul class="systems-list">
				{
					systemsWork.map((item) => (
						<li class="system" data-reveal>
							<div>
								<h4 class="system-name">{item.title}</h4>
								<p class="system-stack">{item.stack}</p>
							</div>
							<ul class="system-points">
								{item.points.map((point) => <li>{point}</li>)}
							</ul>
						</li>
					))
				}
			</ul>
		</div>

		<div class="more">
			<h3 class="label more-title" data-reveal>More</h3>
			<ul>
				{
					moreWork.map((item) => (
						<li data-reveal>
							<a href={item.url} target="_blank" rel="noopener noreferrer" class="more-row">
								<span class="more-name">{item.title}</span>
								<span class="more-note">{item.note}</span>
								<span class="more-go">
									{item.linkLabel}
									<Icon name="arrowUpRight" size={16} />
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<style>
	.projects {
		margin-top: clamp(3.5rem, 7vw, 5.5rem);
	}

	/* ---------- Systems & languages: text rows, same grid as Experience ---------- */
	.systems {
		margin-top: clamp(4.5rem, 9vw, 7rem);
	}

	.systems-title {
		margin-bottom: 1.75rem;
	}

	.systems-title b {
		font-weight: 700;
	}

	.systems-list {
		border-top: 1px solid var(--color-hair);
	}

	.system {
		display: grid;
		gap: 0.9rem;
		padding-block: 2rem;
		border-bottom: 1px solid var(--color-hair);
	}

	@media (min-width: 900px) {
		.system {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
			gap: clamp(3rem, 6vw, 5.5rem);
		}
	}

	.system-name {
		font-size: clamp(1.4rem, 1vw + 1.05rem, 1.75rem);
		font-weight: 700;
		line-height: 1.15;
	}

	.system-stack {
		margin-top: 0.4rem;
		font-size: 0.95rem;
		color: var(--color-line);
		font-weight: 600;
	}

	.system-points {
		display: grid;
		gap: 0.6rem;
		max-width: 38rem;
	}

	.system-points li {
		position: relative;
		padding-left: 1.4rem;
	}

	.system-points li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.72em;
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 999px;
		background: var(--color-fill);
		box-shadow: inset 0 0 0 1.5px var(--color-line);
	}

	.more {
		margin-top: clamp(3.5rem, 7vw, 5rem);
	}

	.more-title {
		margin-bottom: 1rem;
		color: var(--color-muted);
	}

	.more-row {
		display: grid;
		gap: 0.25rem 2rem;
		padding-block: 1.25rem;
		border-bottom: 1px solid var(--color-hair);
	}

	@media (min-width: 768px) {
		.more-row {
			grid-template-columns: 17rem minmax(0, 1fr) auto;
			align-items: baseline;
		}
	}

	.more-name {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.35rem;
		color: var(--color-ink);
	}

	.more-note {
		font-size: 0.98rem;
	}

	.more-go {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-weight: 600;
		font-size: 0.95rem;
		color: var(--color-line);
		transition: gap 0.25s var(--ease-out);
	}

	@media (hover: hover) {
		.more-row:hover .more-go {
			gap: 0.65rem;
		}
		.more-row:hover .more-name {
			color: var(--color-line);
		}
	}
</style>
