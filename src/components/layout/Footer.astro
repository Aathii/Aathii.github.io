---
import { site } from '../../config/site';

const year = new Date().getFullYear();
---

<footer class="footer" data-inert-when-menu>
	<div class="container-page footer-inner">
		<p>&copy; {year} {site.name}</p>
		<p class="footer-mid">Designed and built by me with Astro.</p>
		<a href="#top" class="tlink"><span>Back to top</span> &uarr;</a>
	</div>
</footer>

<style>
	.footer {
		margin-top: clamp(5rem, 10vw, 8rem);
		border-top: 1px solid var(--color-hair);
	}

	.footer-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 2rem;
		padding-block: 1.75rem;
		font-size: 0.9rem;
		color: var(--color-muted);
	}

	.footer-inner .tlink {
		font-size: 0.9rem;
	}
</style>
