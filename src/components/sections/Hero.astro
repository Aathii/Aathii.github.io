---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { socialIcon } from '../ui/icons';
import { mailto, site } from '../../config/site';

const scrollLetters = 'Scroll'.split('');
---

<section id="top-hero" class="hero" aria-labelledby="hero-title" data-inert-when-menu>
	<div class="container-page hero-grid">
		<div class="hero-copy">
			{
				site.availability && (
					<p class="status label hero-in" style="--d: 0s">
						<span class="status-dot" aria-hidden="true" />
						{site.availability}
					</p>
				)
			}

			<h1 id="hero-title" class="hero-title hero-in" style="--d: 0.08s">
				Hi, I'm <b>{site.firstName}</b><span class="dot">.</span>
			</h1>

			<p class="lede hero-lede hero-in" style="--d: 0.3s">
				A <b>developer and co-founder</b> who also works in sales, so I build with the customer in mind.
			</p>

			<div class="hero-actions hero-in" style="--d: 0.45s">
				<Button href="#work" icon="arrowDown">See my work</Button>
				<a href={mailto()} class="tlink"><span>Email me</span> <Icon name="arrowUpRight" size={16} /></a>
			</div>

			<ul class="hero-social hero-in" style="--d: 0.55s" aria-label="Elsewhere">
				{
					site.socials.map((s) => (
						<li>
							<a href={s.url} target="_blank" rel="noopener noreferrer" class="social-link">
								<Icon name={socialIcon(s.label)} size={16} />
								<span>{s.label}</span>
							</a>
						</li>
					))
				}
				{
					site.resumeUrl && (
						<li>
							<a href={site.resumeUrl} download class="social-link">
								<Icon name="download" size={16} />
								<span>Résumé</span>
							</a>
						</li>
					)
				}
			</ul>
		</div>

		<figure class="hero-photo">
			<span class="photo-stack">
				<span class="photo-hatch hatch" data-drift="-10 -8" aria-hidden="true"></span>
				<span class="photo-dots dots" data-drift="8 10" aria-hidden="true"></span>
				<span class="photo-frame">
					<img
						src={site.photo}
						srcset={`${site.photo.replace(/\.webp$/, '-480.webp')} 480w, ${site.photo} 800w`}
						sizes="(min-width: 1024px) 28rem, (min-width: 640px) 20rem, 58vw"
						alt={site.photoAlt}
						width="800"
						height="1000"
						fetchpriority="high"
						decoding="async"
					/>
					<span class="photo-panel" aria-hidden="true"></span>
				</span>
			</span>
			<figcaption class="label photo-caption">University of Toronto · Honours B.Sc.</figcaption>
		</figure>
	</div>

	<div class="container-page scroll-cue" aria-hidden="true">
		<span class="scroll-word label">
			{scrollLetters.map((ch, i) => <span style={`--i:${i}`}>{ch}</span>)}
		</span>
		<span class="scroll-line"></span>
	</div>
</section>

<style>
	.hero {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding-top: 6.5rem;
		padding-bottom: 3rem;
	}

	@media (min-width: 1024px) {
		.hero {
			min-height: calc(100svh - 2 * var(--frame));
			padding-top: 7rem;
			padding-bottom: 7rem;
		}
	}

	.hero-grid {
		display: grid;
		gap: 2.75rem;
		align-items: center;
	}

	@media (min-width: 1024px) {
		.hero-grid {
			grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
			gap: 4rem;
		}
	}

	/* ---------- Copy ---------- */
	.status {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1.75rem;
		color: var(--color-ink-2);
	}

	.status-dot {
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 999px;
		background: var(--color-line);
		animation: pulse 1.8s ease-out infinite;
	}

	.hero-title {
		font-size: clamp(3rem, 6vw + 0.75rem, 6rem);
		line-height: 1;
		letter-spacing: -0.02em;
	}

	.hero-lede {
		max-width: 32rem;
		margin-top: 1.75rem;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.75rem;
		margin-top: 2.5rem;
	}

	.hero-social {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.5rem;
		margin-top: 1.75rem;
	}

	.social-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 2.75rem;
		font-size: 0.95rem;
		color: var(--color-ink-2);
		transition: color 0.2s ease;
	}

	@media (hover: hover) {
		.social-link:hover {
			color: var(--color-line);
		}
	}

	/* ---------- Photo: misregistered-print frame ---------- */
	/* Phones: a compact portrait above the greeting so the name still lands in the first screen. */
	.hero-photo {
		position: relative;
		width: min(58%, 13.5rem);
		margin: 0 0 0.5rem;
		justify-self: start;
		order: -1;
	}

	@media (min-width: 640px) {
		.hero-photo {
			width: min(100%, 20rem);
		}
	}

	@media (min-width: 1024px) {
		.hero-photo {
			order: 0;
			width: 100%;
			max-width: 28rem;
			justify-self: end;
			margin: 0;
		}
	}

	.photo-stack {
		position: relative;
		display: block;
	}

	.photo-frame {
		position: relative;
		z-index: 1;
		display: block;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		border-radius: 14px;
		border: 2px solid var(--color-ink);
		background: var(--color-fill);
	}

	.photo-frame img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.photo-hatch {
		position: absolute;
		z-index: 0;
		inset: 0.75rem -0.75rem -0.75rem 0.75rem;
		border-radius: 14px;
		background-color: var(--color-paper);
	}

	@media (min-width: 1024px) {
		.photo-hatch {
			inset: 1.1rem -1.1rem -1.1rem 1.1rem;
		}
	}

	.photo-dots {
		position: absolute;
		z-index: 0;
		width: 7rem;
		height: 7rem;
		left: -2.25rem;
		top: -2.25rem;
	}

	.photo-panel {
		position: absolute;
		inset: 0;
		background: var(--color-fill);
		transform-origin: top;
	}

	.photo-caption {
		position: relative;
		z-index: 1;
		display: none;
		margin-top: 2.25rem;
		font-size: 0.68rem;
		color: var(--color-muted);
	}

	@media (min-width: 1024px) {
		.photo-caption {
			display: block;
		}
	}

	/* ---------- Scroll cue ---------- */
	.scroll-cue {
		display: none;
	}

	@media (min-width: 1024px) {
		.scroll-cue {
			position: absolute;
			left: 0;
			right: 0;
			bottom: 0;
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			gap: 0.9rem;
		}
	}

	.scroll-word {
		display: inline-flex;
		gap: 0.02em;
		font-size: 0.66rem;
		color: var(--color-muted);
	}

	.scroll-word span {
		display: inline-block;
		animation: bob 6s var(--ease-out) infinite;
		animation-delay: calc(2s + var(--i) * 0.08s);
	}

	.scroll-line {
		width: 1px;
		height: 4.5rem;
		margin-left: 1.25rem;
		background: var(--color-ink);
		opacity: 0.4;
		transform-origin: top;
		animation: grow-y 1.2s var(--ease-soft) both;
		animation-delay: 0.9s;
	}

	/* ---------- Load choreography: waits for html.is-ready (scripts/ready.ts), plays on its own without JS ---------- */
	.hero-in {
		animation: rise 0.8s var(--ease-out) both;
		animation-delay: var(--d, 0s);
	}

	.photo-panel {
		animation: panel-up 0.75s var(--ease-soft) both;
		animation-delay: 0.15s;
	}

	.photo-frame img {
		animation: settle 1.8s cubic-bezier(0.075, 0.82, 0.165, 1) both;
		animation-delay: 0.15s;
	}

	.photo-hatch {
		animation: slide-in 1.1s var(--ease-soft) both;
		animation-delay: 0.45s;
	}

	.photo-dots {
		animation: rise 1s var(--ease-out) both;
		animation-delay: 0.65s;
	}

	:global(.js:not(.is-ready)) .hero-in,
	:global(.js:not(.is-ready)) .photo-panel,
	:global(.js:not(.is-ready)) .photo-frame img,
	:global(.js:not(.is-ready)) .photo-hatch,
	:global(.js:not(.is-ready)) .photo-dots,
	:global(.js:not(.is-ready)) .scroll-line {
		animation-play-state: paused;
	}

	@keyframes panel-up {
		from {
			transform: scaleY(1);
		}
		to {
			transform: scaleY(0);
		}
	}

	@keyframes settle {
		from {
			transform: scale(1.08);
		}
		to {
			transform: none;
		}
	}

	@keyframes slide-in {
		from {
			opacity: 0;
			translate: -1.1rem -1.1rem;
		}
		to {
			opacity: 1;
			translate: 0 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.status-dot,
		.scroll-word span {
			animation: none;
		}
		.photo-panel {
			display: none;
		}
	}
</style>
